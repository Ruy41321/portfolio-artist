# ─────────────────────────────────────────────────────────────
# Portfolio Artist — environment variables
# Copy to `.env` and adjust. In production `scripts/setup.sh` generates it.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Dev (scripts/dev-db.sh or `docker compose up -d postgres`):
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# Database used by integration and e2e tests (it is wiped by the tests!).
TEST_DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio_test

# Secret used by Payload to sign sessions and tokens. Use a long random string:
#   openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public URL of the site, without trailing slash (used for absolute URLs, sitemap, OG, CSRF).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Build the database schema only from migrations (recommended, same as production).
# Set to "true" to let Payload push schema changes automatically while prototyping.
PAYLOAD_DB_PUSH=false

# Folder where uploaded images and PDFs are stored (default: ./media).
# MEDIA_DIR=/app/media

# Maximum upload size in megabytes.
MAX_UPLOAD_MB=20

# Optional: `pnpm seed` creates this admin user if it does not exist (dev/demo only).
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me
